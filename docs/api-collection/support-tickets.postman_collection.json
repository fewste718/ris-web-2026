{
  "info": {
    "name": "ЛР8 — заявки технической поддержки",
    "description": "Запускать по порядку после перезапуска backend. baseUrl=http://localhost:5000, ресурс support-tickets. Учебный X-User-Id: 1 — диспетчер, 2 и 3 — инженеры. ticketId и cancelTicketId заполняются из ответов POST. Данные находятся в памяти, после перезапуска сервера исчезают.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "resource",
      "value": "support-tickets"
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "cancelTicketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Список после перезапуска — 200 и []",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/api/{{resource}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Пустой массив', () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Создать заявку — 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Не печатает сетевой принтер\",\n  \"equipmentId\": 7,\n  \"description\": \"После отправки задания принтер не начинает печать.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/{{resource}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "const created = pm.response.json();",
              "pm.collectionVariables.set('ticketId', String(created.id));",
              "pm.test('Серверные поля', () => { pm.expect(created.id).to.be.a('number'); pm.expect(created.number).to.match(/^SUP-\\d{4}-\\d{4,}$/); pm.expect(created.status).to.eql('New'); pm.expect(created.assigneeUserId).to.eql(null); pm.expect(created.createdByUserId).to.eql(1); pm.expect(created.clientId).to.eql(3); });",
              "pm.test('Location', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/support-tickets/' + created.id));"
            ]
          }
        }
      ]
    },
